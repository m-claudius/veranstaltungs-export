      private function extract_detail_links(string $html): array {
          $results = [];
          if (empty($html)) return $results;
  
          libxml_use_internal_errors(true);
          $dom = new \DOMDocument();
          @$dom->loadHTML(mb_convert_encoding($html, 'HTML-ENTITIES', 'UTF-8'));
          $xp = new \DOMXPath($dom);
  
          // Strategie A: direkte Detail-Links
!         $nodes = $xp->query("//a[contains(@href,'/regional/veranstaltungen/')][contains(@href,'-20200')]");
          foreach ($nodes as $a) {
              $href = $a->getAttribute('href');
              if ($href) $results[] = $this->absolute_url($href);
          }
  
          // Strategie B: sichtbarer „weiterlesen“-Text
          if (empty($results)) {
              $nodes = $xp->query("//a[contains(translate(normalize-space(string(.)),'ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÜ','abcdefghijklmnopqrstuvwxyzäöü'),'weiterlesen')]/@href");
              foreach ($nodes as $attr) {
                  $href = $attr->value;
                  if ($href) $results[] = $this->absolute_url($href);
              }
          }
  
          // Strategie C: Regex-Fallback (falls DOM/XPath an Markup scheitert)
          if (empty($results)) {
!             if (preg_match_all('#/regional/veranstaltungen/[A-Za-z0-9\-\._%]+-20200\.html#u', $html, $m)) {
                  foreach ($m[0] as $p) {
                      $results[] = $this->absolute_url($p);
                  }
              }
          }
  
          return array_values(array_unique($results));
      }
