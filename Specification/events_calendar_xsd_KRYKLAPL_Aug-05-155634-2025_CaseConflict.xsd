<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:ietf:params:xml:ns:xcal"
           xmlns:xcal="urn:ietf:params:xml:ns:xcal"
           xmlns:tec="urn:the-events-calendar:extensions"
           elementFormDefault="qualified">

  <!-- Import base xCal schema -->
  <xs:import namespace="urn:ietf:params:xml:ns:xcal" schemaLocation="http://www.calconnect.org/iCalendar/iCalendar-xCal.xsd"/>

  <!-- Root element for event collection -->
  <xs:element name="events">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="event" maxOccurs="unbounded"/>
        <xs:element ref="venue" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="organizer" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" fixed="1.0"/>
      <xs:attribute name="generator" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Event definition extending xCal VEVENT -->
  <xs:element name="event">
    <xs:complexType>
      <xs:sequence>
        <!-- Core xCal/iCalendar properties -->
        <xs:element name="uid" type="xs:string"/>
        <xs:element name="dtstart" type="dateTimeType"/>
        <xs:element name="dtend" type="dateTimeType" minOccurs="0"/>
        <xs:element name="summary" type="xs:string"/>
        <xs:element name="description" type="xs:string" minOccurs="0"/>
        <xs:element name="location" type="xs:string" minOccurs="0"/>
        <xs:element name="url" type="xs:anyURI" minOccurs="0"/>
        <xs:element name="categories" type="xs:string" minOccurs="0"/>
        <xs:element name="status" type="eventStatusType" minOccurs="0"/>
        
        <!-- The Events Calendar specific properties -->
        <xs:element name="tec-properties" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <!-- WordPress Post Data -->
              <xs:element name="post-id" type="xs:int" minOccurs="0"/>
              <xs:element name="post-slug" type="xs:string" minOccurs="0"/>
              <xs:element name="post-status" type="xs:string" minOccurs="0"/>
              <xs:element name="post-author" type="xs:int" minOccurs="0"/>
              
              <!-- Event specific -->
              <xs:element name="all-day" type="xs:boolean" minOccurs="0"/>
              <xs:element name="duration" type="xs:int" minOccurs="0"/> <!-- in minutes -->
              <xs:element name="cost" type="xs:decimal" minOccurs="0"/>
              <xs:element name="currency-symbol" type="xs:string" minOccurs="0"/>
              <xs:element name="currency-position" type="currencyPositionType" minOccurs="0"/>
              <xs:element name="hide-from-upcoming" type="xs:boolean" minOccurs="0"/>
              <xs:element name="show-map" type="xs:boolean" minOccurs="0"/>
              <xs:element name="show-map-link" type="xs:boolean" minOccurs="0"/>
              <xs:element name="show-tickets" type="xs:boolean" minOccurs="0"/>
              
              <!-- References -->
              <xs:element name="venue-id" type="xs:string" minOccurs="0"/>
              <xs:element name="organizer-id" type="xs:string" minOccurs="0"/>
              
              <!-- Extended properties (your additions) -->
              <xs:element name="target-audience" type="xs:string" minOccurs="0"/>
              <xs:element name="registration-required" type="xs:boolean" minOccurs="0"/>
              <xs:element name="language" type="xs:string" minOccurs="0"/>
              <xs:element name="accessibility" type="xs:string" minOccurs="0"/>
              <xs:element name="format" type="eventFormatType" minOccurs="0"/>
              
              <!-- Media -->
              <xs:element name="featured-image" type="mediaType" minOccurs="0"/>
              <xs:element name="additional-images" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="image" type="mediaType" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              
              <!-- Custom fields -->
              <xs:element name="custom-fields" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="field" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="key" type="xs:string"/>
                          <xs:element name="value" type="xs:string"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Venue definition -->
  <xs:element name="venue">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="venue-id" type="xs:string"/>
        <xs:element name="name" type="xs:string"/>
        <xs:element name="address" type="xs:string" minOccurs="0"/>
        <xs:element name="city" type="xs:string" minOccurs="0"/>
        <xs:element name="state-province" type="xs:string" minOccurs="0"/>
        <xs:element name="postal-code" type="xs:string" minOccurs="0"/>
        <xs:element name="country" type="xs:string" minOccurs="0"/>
        <xs:element name="phone" type="xs:string" minOccurs="0"/>
        <xs:element name="website" type="xs:anyURI" minOccurs="0"/>
        <xs:element name="geo" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="latitude" type="xs:decimal"/>
              <xs:element name="longitude" type="xs:decimal"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="show-map" type="xs:boolean" minOccurs="0"/>
        <xs:element name="show-map-link" type="xs:boolean" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Organizer definition -->
  <xs:element name="organizer">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="organizer-id" type="xs:string"/>
        <xs:element name="name" type="xs:string"/>
        <xs:element name="email" type="xs:string" minOccurs="0"/>
        <xs:element name="phone" type="xs:string" minOccurs="0"/>
        <xs:element name="website" type="xs:anyURI" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Complex type definitions -->
  <xs:complexType name="dateTimeType">
    <xs:sequence>
      <xs:element name="date-time" type="xs:dateTime"/>
      <xs:element name="timezone" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="mediaType">
    <xs:sequence>
      <xs:element name="url" type="xs:anyURI" minOccurs="0"/>
      <xs:element name="file-name" type="xs:string" minOccurs="0"/>
      <xs:element name="mime-type" type="xs:string" minOccurs="0"/>
      <xs:element name="size" type="xs:int" minOccurs="0"/>
      <xs:element name="alt-text" type="xs:string" minOccurs="0"/>
      <xs:element name="base64-data" type="xs:base64Binary" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string"/>
  </xs:complexType>

  <!-- Simple type definitions -->
  <xs:simpleType name="eventStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="TENTATIVE"/>
      <xs:enumeration value="CONFIRMED"/>
      <xs:enumeration value="CANCELLED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="currencyPositionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="prefix"/>
      <xs:enumeration value="suffix"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="eventFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="in-person"/>
      <xs:enumeration value="online"/>
      <xs:enumeration value="hybrid"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>